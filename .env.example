NOTION_API_KEY=ntn_xxx
# 수집 대상은 아래 둘 중 하나만 채우면 된다.
#  - 문서가 어떤 페이지 밑에 하위 페이지로 달려 있으면 ROOT_PAGE_ID (우리 구조)
#  - 문서가 데이터베이스(표)에 행으로 쌓여 있으면 DATABASE_ID
NOTION_ROOT_PAGE_ID=xxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
SLACK_BOT_TOKEN=xoxb-xxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxx
SLACK_APP_TOKEN=xapp-xxx
KAKAOWORK_APP_KEY=xxxxxxxxxxxxxxxx
KAKAOWORK_WEBHOOK_SECRET=
CHROMA_PERSIST_DIR=./chroma_data
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PREFIX=uploads
AWS_MAX_UPLOAD_SIZE_MB=10
