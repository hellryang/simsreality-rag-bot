# 이 파일을 .env 로 복사해서 값을 채운다.   cp .env.example .env
#
# [필수] 6개만 채우면 질문하기·예약하기가 동작한다.
# [선택]은 그 기능을 켤 때만 필요하고, 비워 두어도 앱이 기동한다.
# .env 는 저장소에 올리지 않는다(.gitignore). 서버에서는 chmod 600.


# ===== [필수] =====================================================

# --- Claude ---
# Anthropic Console → API Keys
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- 노션 캘린더 (질문하기 조회 + 예약하기 등록) ---
# 노션 → 설정 → 연결 → 내부 통합 토큰.
# 발급만으로는 부족하다. 대상 캘린더 DB를 이 통합과 **연결**해야 읽고 쓸 수 있다
# (연결하지 않으면 키가 맞아도 404가 난다).
NOTION_PRIVATESPACE_API=ntn_xxx
# 일정을 조회·등록할 캘린더 DB ID (노션 링크의 32자리)
NOTION_CALENDAR_DB_ID=xxxxxxxxxxxxxxxx

# --- 카카오워크 ---
# 관리자 → 봇 → 앱 키. DM 발송 등 Web API 호출에 쓴다.
KAKAOWORK_APP_KEY=xxxxxxxxxxxxxxxx
# 요청 검증용 공유 비밀(아무 긴 랜덤 문자열).
# 카카오워크는 인증 헤더도 서명도 주지 않는다. 그래서 관리자에 등록하는 URL의
# ?token= 에 이 값을 붙이고 서버가 대조한다. 비우면 검증이 통째로 꺼진다.
#   Request URL   http://<서버주소>:8000/kakao/request?token=<이 값>
#   Callback URL  http://<서버주소>:8000/kakao/callback?token=<이 값>
KAKAOWORK_CALLBACK_TOKEN=xxxxxxxxxxxxxxxx

# --- 벡터 검색 스위치 ---
# false 로 둔다. 질문하기는 노션 캘린더를 직접 조회하므로 벡터 검색을 쓰지 않는다.
# 기본값이 true 라서 이 줄을 빼면 켜진 것으로 동작하고, requirements.txt 에서
# chromadb·sentence-transformers 를 선택으로 돌려놨기 때문에 질문하기가 실패한다.
USE_VECTOR_SEARCH=false


# ===== [선택] 해당 기능을 켤 때만 =====================================

# --- 파일 올리기 (현재 사용하지 않음) ---
# 업로드 링크를 만들 때만 쓰는 공개 주소. 비우면 http://localhost:8000 이 쓰인다.
# KAKAOWORK_PUBLIC_URL=http://<서버주소>:8000

# --- 사내 문서 수집 (벡터 검색을 켤 때만) ---
# 캘린더가 아니라 사내 문서를 긁어 벡터 DB에 넣는 용도다(build_db.py).
# 수집 대상은 둘 중 하나만 채운다.
#   ROOT_PAGE_ID : 문서가 어떤 페이지 밑에 하위 페이지로 달려 있을 때 (우리 구조)
#   DATABASE_ID  : 문서가 데이터베이스(표)에 행으로 쌓여 있을 때
# NOTION_API_KEY=ntn_xxx
# NOTION_ROOT_PAGE_ID=xxxxxxxxxxxxxxxx
# NOTION_DATABASE_ID=
# CHROMA_PERSIST_DIR=./chroma_data

# --- Slack (개발하지 않기로 함) ---
# SLACK_BOT_TOKEN=xoxb-xxx
# SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxx
# SLACK_APP_TOKEN=xapp-xxx
