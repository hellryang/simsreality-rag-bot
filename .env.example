NOTION_API_KEY=ntn_xxx
# 수집 대상은 아래 둘 중 하나만 채우면 된다.
#  - 문서가 어떤 페이지 밑에 하위 페이지로 달려 있으면 ROOT_PAGE_ID (우리 구조)
#  - 문서가 데이터베이스(표)에 행으로 쌓여 있으면 DATABASE_ID
NOTION_ROOT_PAGE_ID=xxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
SLACK_BOT_TOKEN=xoxb-xxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxx
SLACK_APP_TOKEN=xapp-xxx
KAKAOWORK_APP_KEY=xxxxxxxxxxxxxxxx
# 콜백/업로드 링크 보호용 공유 비밀 (아무 긴 랜덤 문자열)
KAKAOWORK_CALLBACK_TOKEN=xxxxxxxxxxxxxxxx
# 사용자 브라우저가 접속할 공개 주소 (터널 또는 배포 주소)
KAKAOWORK_PUBLIC_URL=http://localhost:8000
CHROMA_PERSIST_DIR=./chroma_data

# --- Notion 쓰기 (봇 → 노션 일정 등록) ---
# 쓰기 권한이 있는 Integration 키. 수집용 NOTION_API_KEY와 별개다.
NOTION_PRIVATESPACE_API=ntn_xxx
# 일정을 넣을 캘린더 DB ID
NOTION_CALENDAR_DB_ID=xxxxxxxxxxxxxxxx
